# Deep Research System Environment Configuration
# Copy this file to .env and fill in your actual values

# === API Keys (Required) ===
OPENAI_API_KEY=your_openai_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# === API Keys (Optional) ===
SENDGRID_API_KEY=your_sendgrid_api_key_here  # For email delivery
LANGSMITH_API_KEY=your_langsmith_api_key_here  # For tracing/debugging

# === Architecture Control ===
USE_NEW_ARCHITECTURE=false  # Start with old architecture for safety
SHADOW_MODE_PERCENTAGE=0.1  # Run 10% of queries in shadow mode
SHADOW_MODE_ENABLED=true    # Enable shadow comparisons

# === Feature Flags ===
UI_TOGGLE_ENABLED=false     # Initially disable UI toggle
BETA_USER_PERCENTAGE=0      # No beta users initially

# === Performance Monitoring ===
PERFORMANCE_LOG_LEVEL=INFO
PERFORMANCE_DATA_DIR=./performance_data
PERFORMANCE_RETENTION_DAYS=90

# === Cache Configuration ===
CACHE_TTL_HOURS=24          # Cache for 24 hours
CACHE_MAX_SIZE_MB=100       # Limit cache to 100MB
CACHE_ENABLED=true          # Enable caching

# === Error Handling ===
ERROR_RETRY_ENABLED=true    # Enable automatic retries
ERROR_MAX_RETRIES=3         # Maximum retry attempts
ERROR_BACKOFF_BASE=1.5      # Exponential backoff base

# === Monitoring Endpoints ===
ENABLE_METRICS_ENDPOINT=true
METRICS_PORT=9090